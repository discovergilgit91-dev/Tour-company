NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only — never prefix with NEXT_PUBLIC_. Receives "Plan Your Trip"
# form submissions. Use the n8n test webhook URL while developing, swap
# in the production one before launch; no code change needed either way.
N8N_WEBHOOK_URL=your-n8n-webhook-url

# Server-only — never prefix with NEXT_PUBLIC_. Receives tour/event
# "Reserve your spot" submissions (/book). A separate webhook from the one
# above because it's a different form with a different payload shape.
N8N_RESERVATION_WEBHOOK_URL=your-n8n-reservation-webhook-url

# Server-only — never prefix with NEXT_PUBLIC_. The n8n Chat Trigger webhook
# for the site's chat widget. Only app/api/chat/route.ts reads it, so the
# browser never sees it. Use the n8n Chat Trigger's "/chat" webhook URL.
N8N_CHATBOT_WEBHOOK_URL=your-n8n-chatbot-webhook-url

# Server-only — never prefix with NEXT_PUBLIC_. Receives "Build Your Own Trip"
# (/build-your-trip) submissions. A separate webhook from the ones above
# because it's a different form with its own payload shape.
N8N_CUSTOM_TRIP_WEBHOOK_URL=your-n8n-custom-trip-webhook-url

# Server-only — never prefix with NEXT_PUBLIC_. The n8n lookup webhook behind
# My Account → My Trip Requests. The site POSTs { "email": "<signed-in user>" }
# and expects { "requests": [...] } rows read from the Google Sheets tabs for
# Plan Your Trip, Reserve Your Spot and Build Your Own Trip (row shape is
# documented at the top of lib/getMyTripRequests.ts). Anyone holding this URL
# can look up any email, so keep it secret. If it is unset or the call fails,
# the page simply shows its empty state.
N8N_LOOKUP_WEBHOOK_URL=your-n8n-lookup-webhook-url

# Server-only — never prefix with NEXT_PUBLIC_ (it must never reach the browser).
# Sent as the x-lookup-secret header on every call to the lookup webhook above.
# It must match the secret configured in the n8n lookup workflow's "Check Secret"
# node, or n8n will reject the request and My Trip Requests will show its empty state.
N8N_LOOKUP_SECRET=your-secret-here
